# --------------------------------- 
SOL_INPUT_PRICE_PER_MILLION=4.00 
SOL_CACHED_INPUT_PRICE_PER_MILLION=0.40 
SOL_OUTPUT_PRICE_PER_MILLION=20.00 
SOL_CACHE_WRITE_PRICE_PER_MILLION=5.00 
