MANTLE_PROJECT=put_your_mantle_project_name
MANTLE_SECRET_NAME=put_your_mantle_secret_name
AWS_ACCESS_KEY_ID=put_your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=put_your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1 # DEFAULT

DISCORD_TOKEN=put_your_discord_bot_token
ALLOWED_USER_IDS=put_your_discord_id # should be numbers
ALLOWED_CHANNEL_IDS=put_your_discord_channel_id # should be numbers

TAVILY_API_KEY=put_your_tavily_api_key

CODEX_SUPPORTS_VISION=true
CONVERSATION_HISTORY_LIMIT=4

CODEX_MODEL=openai.gpt-5.6-sol
CHAT_MODEL=openai.gpt-5.6-luna

# --------------------------------- 
